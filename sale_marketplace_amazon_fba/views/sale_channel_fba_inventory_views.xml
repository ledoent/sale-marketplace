<odoo>
    <record id="sale_channel_fba_inventory_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.fba.inventory</field>
        <field name="arch" type="xml">
            <list>
                <field name="sale_channel_id" />
                <field name="seller_sku" />
                <field name="product_id" />
                <field name="fulfillable_qty" />
                <field name="inbound_qty" />
                <field name="reserved_qty" />
                <field name="unsellable_qty" />
                <field name="odoo_qty" />
                <field name="drift" />
                <field name="last_sync_date" />
            </list>
        </field>
    </record>

    <record id="sale_channel_fba_inventory_view_form" model="ir.ui.view">
        <field name="model">sale.channel.fba.inventory</field>
        <field name="arch" type="xml">
            <form string="FBA Inventory">
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="seller_sku" />
                        <field name="product_id" />
                        <field name="fulfillable_qty" />
                        <field name="inbound_qty" />
                        <field name="reserved_qty" />
                        <field name="unsellable_qty" />
                        <field name="total_qty" />
                        <field name="odoo_qty" />
                        <field name="drift" />
                        <field name="last_sync_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_channel_fba_inventory_action" model="ir.actions.act_window">
        <field name="name">FBA Inventory</field>
        <field name="res_model">sale.channel.fba.inventory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
