<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_amazon_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-secondary"
                        invisible="channel_type != 'amazon'"
                    />
                </header>
            </xpath>
            <group name="general_info" position="after">
                <group name="amazon_config" invisible="channel_type != 'amazon'">
                    <group name="amazon_connection" string="Connection">
                        <field
                            name="amazon_marketplace_id"
                            required="channel_type == 'amazon'"
                        />
                        <field name="amazon_seller_id" />
                        <field
                            name="amazon_client_id"
                            required="channel_type == 'amazon'"
                        />
                        <field
                            name="amazon_client_secret"
                            password="True"
                            required="channel_type == 'amazon'"
                            groups="base.group_system"
                        />
                        <field
                            name="amazon_refresh_token"
                            password="True"
                            required="channel_type == 'amazon'"
                            groups="base.group_system"
                        />
                        <field name="amazon_sandbox" />
                    </group>
                    <group name="amazon_settings" string="Import Settings">
                        <field
                            name="warehouse_id"
                            required="channel_type == 'amazon'"
                        />
                        <field name="amazon_import_days_back" />
                        <field name="amazon_last_import_date" />
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
