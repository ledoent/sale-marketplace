<odoo>
    <record id="walmart_return_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.walmart.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="return_order_id" />
                <field name="sale_channel_id" />
                <field name="purchase_order_id" />
                <field name="order_id" />
                <field name="return_picking_id" />
                <field name="credit_note_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="walmart_return_view_form" model="ir.ui.view">
        <field name="model">sale.channel.walmart.return</field>
        <field name="arch" type="xml">
            <form string="Walmart Return">
                <header>
                    <button
                        name="action_walmart_issue_refund"
                        type="object"
                        string="Issue Walmart Refund"
                        class="btn-primary"
                        invisible="walmart_refund_issued"
                        groups="sales_team.group_sale_salesman"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="return_order_id" />
                        <field name="purchase_order_id" />
                        <field name="order_id" />
                        <field name="return_picking_id" />
                        <field name="credit_note_id" />
                        <field name="walmart_refund_id" />
                        <field name="walmart_refund_issued" />
                        <field name="state" />
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id" />
                            <field name="seller_sku" />
                            <field name="quantity" />
                            <field name="return_reason" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="walmart_return_action" model="ir.actions.act_window">
        <field name="name">Walmart Returns</field>
        <field name="res_model">sale.channel.walmart.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_walmart_returns"
        name="Returns"
        parent="sale_marketplace_walmart.menu_walmart_root"
        action="walmart_return_action"
        sequence="40"
    />
</odoo>
