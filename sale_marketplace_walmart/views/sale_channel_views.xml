<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <group name="general_info" position="after">
                <group
                    name="walmart_config"
                    string="Walmart"
                    invisible="channel_type != 'walmart'"
                >
                    <button
                        name="action_walmart_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-secondary"
                    />
                    <field
                        name="walmart_client_id"
                        required="channel_type == 'walmart'"
                    />
                    <field
                        name="walmart_client_secret"
                        password="True"
                        required="channel_type == 'walmart'"
                        groups="base.group_system"
                    />
                    <field name="walmart_market" required="channel_type == 'walmart'" />
                    <field name="walmart_sandbox" />
                    <field name="warehouse_id" required="channel_type == 'walmart'" />
                </group>
            </group>
        </field>
    </record>
</odoo>
