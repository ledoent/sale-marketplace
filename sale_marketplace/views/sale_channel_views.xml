<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="%(sale_channel_product_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    context="{'search_default_sale_channel_id': id, 'default_sale_channel_id': id}"
                >
                    <field
                        name="sale_channel_product_count"
                        widget="statinfo"
                        string="Channel Products"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
