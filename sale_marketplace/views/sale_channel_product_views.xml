<odoo>
    <record id="sale_channel_product_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_id" />
                <field name="product_id" />
                <field name="sale_channel_id" />
            </list>
        </field>
    </record>

    <record id="sale_channel_product_view_form" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field name="arch" type="xml">
            <form string="Channel Product">
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="product_id" />
                        <field name="external_id" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_channel_product_view_search" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field name="arch" type="xml">
            <search string="Channel Products">
                <field name="external_id" />
                <field name="product_id" />
                <field name="sale_channel_id" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Sale Channel"
                        name="group_channel"
                        context="{'group_by': 'sale_channel_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="sale_channel_product_action" model="ir.actions.act_window">
        <field name="name">Channel Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.channel.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menuitem_sale_channel_products"
        name="Channel Products"
        parent="sale.menu_sale_config"
        action="sale_channel_product_action"
        sequence="20"
    />
</odoo>
