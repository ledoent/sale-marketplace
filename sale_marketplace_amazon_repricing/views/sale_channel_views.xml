<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_marketplace_amazon.sale_channel_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_amazon_test_connection']"
                position="after"
            >
                <button
                    name="action_amazon_setup_notifications"
                    type="object"
                    string="Setup Notifications"
                    class="btn-secondary"
                    invisible="channel_type != 'amazon'"
                />
            </xpath>
            <group name="amazon_config" position="after">
                <group
                    name="amazon_repricing"
                    string="Repricing (SQS)"
                    invisible="channel_type != 'amazon'"
                >
                    <field name="notifications_enabled" />
                    <field name="sqs_queue_url" />
                    <field name="aws_region" />
                    <field name="aws_access_key_id" groups="base.group_system" />
                    <field
                        name="aws_secret_access_key"
                        password="True"
                        groups="base.group_system"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
