<odoo>
    <record id="stock_picking_view_form_mcf" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_amz_mcf_fulfill"
                    type="object"
                    string="Fulfill via Amazon MCF"
                    class="btn-secondary"
                />
            </xpath>
        </field>
    </record>
</odoo>
