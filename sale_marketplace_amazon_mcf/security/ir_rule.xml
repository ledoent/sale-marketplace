<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="model_sale_channel_fulfillment_order_company_rule" model="ir.rule">
        <field name="name">sale_channel_fulfillment_order company</field>
        <field name="model_id" ref="model_sale_channel_fulfillment_order" />
        <field
            name="domain_force"
        >['|', ('sale_channel_id.company_id', '=', False), ('sale_channel_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="model_sale_channel_fulfillment_order_line_company_rule" model="ir.rule">
        <field name="name">sale_channel_fulfillment_order_line company</field>
        <field name="model_id" ref="model_sale_channel_fulfillment_order_line" />
        <field
            name="domain_force"
        >['|', ('fulfillment_order_id.sale_channel_id.company_id', '=', False), ('fulfillment_order_id.sale_channel_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
