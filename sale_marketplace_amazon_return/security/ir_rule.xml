            name="domain_force"
        >['|', ('sale_channel_id.company_id', '=', False), ('sale_channel_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="model_sale_channel_return_line_company_rule" model="ir.rule">
        <field name="name">sale_channel_return_line company</field>
        <field name="model_id" ref="model_sale_channel_return_line" />
        <field
            name="domain_force"
        >['|', ('return_id.sale_channel_id.company_id', '=', False), ('return_id.sale_channel_id.company_id', 'in', company_ids)]</field>
    </record>
