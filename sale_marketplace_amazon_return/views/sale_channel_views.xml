<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_marketplace_amazon.sale_channel_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_amazon_test_connection']"
                position="after"
            >
                <button
                    name="action_amazon_sync_returns"
                    type="object"
                    string="Sync Returns"
                    class="btn-secondary"
                    invisible="channel_type != 'amazon'"
                />
            </xpath>
            <group name="amazon_config" position="after">
                <group
                    name="amazon_returns"
                    string="Returns"
                    invisible="channel_type != 'amazon'"
                >
                    <field name="amazon_returns_enabled" />
                    <field name="amazon_auto_return_picking" />
                    <field name="amazon_auto_credit_note" />
                    <field name="last_return_sync_date" />
                </group>
            </group>
        </field>
    </record>
</odoo>
