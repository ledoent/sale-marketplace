<odoo noupdate="1">
    <record id="ir_cron_walmart_import_orders" model="ir.cron">
        <field name="name">Walmart: Import Orders</field>
        <field name="model_id" ref="sale_channel.model_sale_channel" />
        <field name="state">code</field>
        <field name="code">model._cron_walmart_import_orders()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>

    <record id="ir_cron_walmart_acknowledge_orders" model="ir.cron">
        <field name="name">Walmart: Acknowledge Orders</field>
        <field name="model_id" ref="sale_channel.model_sale_channel" />
        <field name="state">code</field>
        <field name="code">model._cron_walmart_acknowledge_orders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>
</odoo>
