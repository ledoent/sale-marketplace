<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field
            name="inherit_id"
            ref="sale_marketplace_walmart.sale_channel_view_form"
        />
        <field name="arch" type="xml">
            <button name="action_walmart_test_connection" position="after">
                <button
                    name="action_walmart_push_inventory"
                    type="object"
                    string="Push Inventory"
                    class="btn-secondary"
                    invisible="channel_type != 'walmart' or not inventory_sync_enabled"
                />
            </button>
            <group name="walmart_config" position="after">
                <group
                    name="walmart_inventory"
                    string="Walmart Inventory"
                    invisible="channel_type != 'walmart'"
                >
                    <field name="inventory_sync_enabled" />
                    <field
                        name="inventory_expose_ratio"
                        invisible="not inventory_sync_enabled"
                    />
                    <field
                        name="inventory_min_reserve"
                        invisible="not inventory_sync_enabled"
                    />
                    <field
                        name="inventory_location_ids"
                        widget="many2many_tags"
                        invisible="not inventory_sync_enabled"
                    />
                    <field name="last_inventory_sync_date" />
                </group>
            </group>
        </field>
    </record>
</odoo>
