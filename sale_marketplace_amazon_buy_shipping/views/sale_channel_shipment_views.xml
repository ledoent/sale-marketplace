<odoo>
    <record id="sale_channel_shipment_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" />
                <field name="sale_channel_id" />
                <field name="picking_id" />
                <field name="carrier_name" />
                <field name="service_name" />
                <field name="tracking_number" />
                <field name="cost" />
            </list>
        </field>
    </record>

    <record id="sale_channel_shipment_view_form" model="ir.ui.view">
        <field name="model">sale.channel.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button
                        name="action_download_label"
                        type="object"
                        string="Download Label"
                        class="btn-primary"
                        invisible="not label_attachment_id"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="picking_id" />
                        <field name="amazon_shipment_id" />
                        <field name="carrier_name" />
                        <field name="service_name" />
                        <field name="tracking_number" />
                        <field name="cost" />
                        <field name="currency_id" />
                        <field name="label_attachment_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_channel_shipment_action" model="ir.actions.act_window">
        <field name="name">Amazon Shipments</field>
        <field name="res_model">sale.channel.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
