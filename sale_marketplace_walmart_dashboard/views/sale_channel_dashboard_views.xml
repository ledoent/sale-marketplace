<odoo>
    <record id="sale_channel_walmart_dashboard_view_form" model="ir.ui.view">
        <field name="model">sale.channel.walmart.dashboard</field>
        <field name="arch" type="xml">
            <form string="Walmart Dashboard" create="false">
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field
                            name="health_status"
                            widget="badge"
                            decoration-danger="health_status == 'attention'"
                            decoration-success="health_status == 'ok'"
                        />
                    </group>
                    <group string="Orders">
                        <field name="orders_total" />
                        <field name="orders_unshipped" />
                    </group>
                    <group string="Listings &amp; Pricing">
                        <field name="listings_total" />
                        <field name="listings_inventory_synced" />
                        <field name="price_changes_7d" />
                    </group>
                    <group string="Settlements">
                        <field name="settlement_groups" />
                        <field name="recon_matched" />
                        <field name="recon_variance" />
                        <field name="recon_no_invoice" />
                        <field name="recon_variance_amount" />
                        <button
                            name="action_open_recon_variance"
                            type="object"
                            string="View Variance"
                            class="btn-link"
                        />
                    </group>
                    <group string="Returns">
                        <field name="returns_open" />
                        <field name="returns_credited" />
                        <button
                            name="action_open_returns_open"
                            type="object"
                            string="View Open Returns"
                            class="btn-link"
                        />
                    </group>
                    <group string="Health">
                        <field name="failed_jobs" />
                        <button
                            name="action_open_failed_jobs"
                            type="object"
                            string="View Failed Jobs"
                            class="btn-link"
                        />
                        <field name="last_order_sync" />
                        <field name="last_price_sync" />
                        <field name="last_inventory_sync" />
                        <field name="last_settlement_sync" />
                        <field name="last_return_sync" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_channel_walmart_dashboard_action" model="ir.actions.act_window">
        <field name="name">Walmart Dashboard</field>
        <field name="res_model">sale.channel.walmart.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_sale_channel_walmart_dashboard"
        name="Dashboard"
        parent="sale_marketplace_walmart.menu_walmart_root"
        action="sale_channel_walmart_dashboard_action"
        sequence="10"
    />
</odoo>
