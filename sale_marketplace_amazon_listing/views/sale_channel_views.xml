<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_marketplace_amazon.sale_channel_view_form" />
        <field name="arch" type="xml">
            <button name="action_amazon_test_connection" position="after">
                <button
                    name="action_amazon_import_listings"
                    type="object"
                    string="Import Listings"
                    class="btn-secondary"
                    invisible="channel_type != 'amazon'"
                />
            </button>
        </field>
    </record>
</odoo>
