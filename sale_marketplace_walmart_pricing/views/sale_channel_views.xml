<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field
            name="inherit_id"
            ref="sale_marketplace_walmart.sale_channel_view_form"
        />
        <field name="arch" type="xml">
            <button name="action_walmart_test_connection" position="after">
                <button
                    name="action_walmart_push_prices"
                    type="object"
                    string="Push Prices"
                    class="btn-secondary"
                    invisible="channel_type != 'walmart'"
                />
            </button>
            <group name="walmart_config" position="after">
                <group
                    name="walmart_pricing"
                    string="Walmart Pricing"
                    invisible="channel_type != 'walmart'"
                >
                    <field name="walmart_price_push_enabled" />
                    <field name="walmart_pricing_mode" />
                    <field
                        name="walmart_pricing_pricelist_id"
                        invisible="walmart_pricing_mode != 'pricelist'"
                    />
                    <field name="walmart_floor_margin_pct" />
                    <field name="walmart_last_price_sync_date" />
                </group>
            </group>
        </field>
    </record>
</odoo>
