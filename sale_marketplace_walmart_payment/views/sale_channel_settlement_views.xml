<odoo>
    <record id="walmart_settlement_group_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.walmart.settlement.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="settlement_date" />
                <field name="sale_channel_id" />
                <field name="walmart_settlement_id" />
                <field name="original_total" />
                <field name="account_move_id" />
            </list>
        </field>
    </record>

    <record id="walmart_settlement_group_view_form" model="ir.ui.view">
        <field name="model">sale.channel.walmart.settlement.group</field>
        <field name="arch" type="xml">
            <form string="Walmart Settlement">
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="walmart_settlement_id" />
                        <field name="settlement_date" />
                        <field name="original_total" />
                        <field name="currency_id" />
                        <field name="account_move_id" />
                    </group>
                    <notebook>
                        <page string="Financial Events">
                            <field name="financial_event_ids">
                                <list>
                                    <field name="event_type" />
                                    <field name="purchase_order_id" />
                                    <field name="amount" />
                                    <field name="description" />
                                </list>
                            </field>
                        </page>
                        <page string="Reconciliation">
                            <field name="reconciliation_ids">
                                <list>
                                    <field name="purchase_order_id" />
                                    <field name="order_id" />
                                    <field name="invoice_id" />
                                    <field name="settled_principal" />
                                    <field name="invoiced_total" />
                                    <field name="variance" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="walmart_settlement_group_action" model="ir.actions.act_window">
        <field name="name">Walmart Settlements</field>
        <field name="res_model">sale.channel.walmart.settlement.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Standalone list for the reconciliation model so the dashboard
         "View Variance" drill-down shows meaningful columns (not just ID). -->
    <record id="walmart_settlement_reconciliation_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.walmart.settlement.reconciliation</field>
        <field name="arch" type="xml">
            <list>
                <field name="settlement_group_id" />
                <field name="sale_channel_id" />
                <field name="purchase_order_id" />
                <field name="order_id" />
                <field name="invoice_id" />
                <field name="settled_principal" />
                <field name="invoiced_total" />
                <field name="variance" />
                <field name="state" />
            </list>
        </field>
    </record>

    <menuitem
        id="menu_walmart_settlements"
        name="Settlements"
        parent="sale_marketplace_walmart.menu_walmart_root"
        action="walmart_settlement_group_action"
        sequence="30"
    />
</odoo>
