<odoo>
    <record id="sale_channel_product_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field
            name="inherit_id"
            ref="sale_marketplace.sale_channel_product_view_tree"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="current_list_price" optional="show" />
                <field name="buy_box_price" optional="show" />
                <field name="buy_box_winner" optional="hide" />
            </field>
        </field>
    </record>

    <record id="sale_channel_product_view_form" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field
            name="inherit_id"
            ref="sale_marketplace.sale_channel_product_view_form"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="current_list_price" />
                <field name="buy_box_price" />
                <field name="buy_box_winner" />
            </field>
            <field name="external_id" position="after">
                <field name="price_history_ids" readonly="1" colspan="2">
                    <list>
                        <field name="date" />
                        <field name="old_price" />
                        <field name="new_price" />
                        <field name="trigger" />
                        <field name="rule" />
                        <field name="user_id" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
