<odoo>
    <record id="sale_channel_product_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field
            name="inherit_id"
            ref="sale_marketplace.sale_channel_product_view_tree"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="est_margin_pct" optional="hide" />
                <field name="below_target_margin" optional="hide" />
            </field>
        </field>
    </record>

    <record id="sale_channel_product_view_form" model="ir.ui.view">
        <field name="model">sale.channel.product</field>
        <field
            name="inherit_id"
            ref="sale_marketplace.sale_channel_product_view_form"
        />
        <field name="arch" type="xml">
            <field name="external_id" position="after">
                <field name="is_fba" />
                <field name="referral_fee" />
                <field name="fulfillment_fee" />
                <field name="variable_closing_fee" />
                <field name="other_fees" />
                <field name="total_fees" />
                <field name="fee_basis_price" />
                <field name="est_net_proceeds" />
                <field name="est_net_margin" />
                <field name="est_margin_pct" />
                <field name="below_target_margin" />
            </field>
        </field>
    </record>
</odoo>
