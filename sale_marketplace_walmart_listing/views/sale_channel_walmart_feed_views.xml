<odoo>
    <record id="walmart_feed_view_tree" model="ir.ui.view">
        <field name="model">sale.channel.walmart.feed</field>
        <field name="arch" type="xml">
            <list>
                <field name="submitted_date" />
                <field name="sale_channel_id" />
                <field name="feed_id" />
                <field name="feed_type" />
                <field name="items_received" />
                <field name="items_succeeded" />
                <field name="items_failed" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="walmart_feed_view_form" model="ir.ui.view">
        <field name="model">sale.channel.walmart.feed</field>
        <field name="arch" type="xml">
            <form string="Walmart Feed">
                <sheet>
                    <group>
                        <field name="sale_channel_id" />
                        <field name="feed_id" />
                        <field name="feed_type" />
                        <field name="state" />
                        <field name="submitted_date" />
                        <field name="items_received" />
                        <field name="items_succeeded" />
                        <field name="items_failed" />
                        <field name="error_message" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="walmart_feed_action" model="ir.actions.act_window">
        <field name="name">Walmart Feeds</field>
        <field name="res_model">sale.channel.walmart.feed</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_walmart_feeds"
        name="Feeds"
        parent="sale_marketplace_walmart.menu_walmart_root"
        action="walmart_feed_action"
        sequence="50"
    />
</odoo>
