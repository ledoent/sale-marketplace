<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field
            name="inherit_id"
            ref="sale_marketplace_walmart.sale_channel_view_form"
        />
        <field name="arch" type="xml">
            <button name="action_walmart_test_connection" position="after">
                <button
                    name="action_walmart_import_listings"
                    type="object"
                    string="Import Listings"
                    class="btn-secondary"
                />
                <button
                    name="action_walmart_export_listings"
                    type="object"
                    string="Export Listings"
                    class="btn-secondary"
                />
            </button>
        </field>
    </record>
</odoo>
